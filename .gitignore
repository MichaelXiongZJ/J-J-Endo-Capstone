# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Data and model weights — these live in Google Drive, never in git.
# Footage may contain identifiable workers (context.md §10).
data/raw_videos/*
data/frames/*
data/dataset/*
models/*
outputs/*
!**/.gitkeep

# Calibration configs ARE tracked — they are small, hand-authored, and
# reproducing them costs ~10 min of tape-measure work per camera.
!data/calibration/
!data/calibration/*.json

# Keep the reference frames out of git though (they are footage).
data/calibration/*.jpg
data/calibration/*.png

# Notebook outputs
*.ipynb_checkpoints/

# Downloaded dataset metadata (probe artifacts, not source)
data/sdg_warehouse_meta/

# SDG-Warehouse slice: fetched clips and everything derived from them.
# All regenerable via scripts/fetch_sdg.py + sdg_calibration.py + sdg_to_coco.py.
data/sdg/
data/sdg_probe/
data/calibration/sdg_*.json
data/validation/sdg_ground_truth.json
data/sdg_box_pickup/

# Roboflow downloads and derived datasets (regenerable via scripts/fetch_roboflow.py)
data/real/
data/dataset_v2/
data/dataset_v3/
# Web report outputs
!outputs/web/
outputs/web/*
!outputs/web/*.py

# PDF documents
*.pdf

# Local model weights
models/phone/*.pth
models/phone/*.ckpt
